
let maxX = 0;
let maxY = 0;
let maxZ = 0;

let signedX = 0;
let signedY = 0;
let signedZ = 0;

function updateDirection(x, y, z) {
  if (Math.abs(x) > maxX) {
    maxX = Math.abs(x);
    signedX = x;
  }

  if (Math.abs(y) > maxY) {
    maxY = Math.abs(y);
    signedY = y;
  }

  if (Math.abs(z) > maxZ) {
    maxZ = Math.abs(z);
    signedZ = z;
  }

  const axes = [
    { name: "X AXIS", value: maxX, signed: signedX },
    { name: "Y AXIS", value: maxY, signed: signedY },
    { name: "Z AXIS", value: maxZ, signed: signedZ }
  ];

  axes.sort((a, b) => b.value - a.value);

  const strongest = axes[0];

  document.getElementById("resultDirection").textContent =
    strongest.name + (strongest.signed >= 0 ? " (+)" : " (-)");

  document.getElementById("resultValue").textContent =
    strongest.value.toFixed(2) + " G";

  document.getElementById("resultDescription").textContent =
    "Strongest acceleration was detected along the " +
    strongest.name + " in the " +
    (strongest.signed >= 0 ? "positive" : "negative") +
    " direction.";
}
